local CasesPage = makePage("Cases")
local caseData = {}
local caseRows = {}
local function parsePrice(text)
 if text:lower():find("free", 1, true) then
 return 0
 end
 local num = text:match("Price:%s*%$?%s*([%d,%.]+)")
 if num then
 return tonumber((num:gsub(",", ""))) or math.huge
 end
 return math.huge
end
local function fmtMoney(n)
 if n == 0 then
 return "Free"
 end
 if n == math.huge then
 return "?"
 end
 local s = (n >= 100) and string.format("%d", math.floor(n + 0.5)) or string.format("%.2f", n)
 local int, rest = s:match("^(%d+)(.*)$")
 int = (int:reverse():gsub("(%d%d%d)", "%1,")):reverse()
 int = int:gsub("^,", "")
 return "$" .. int .. rest
end
local function loadCases()
 local root = casesRoot()
 local list = root and root:FindFirstChild("CasesList")
 caseData = {}
 if not list then
 return 0
 end
 for _, c in ipairs(list:GetChildren()) do
 if c:IsA("GuiButton") then
 local text = c:IsA("TextButton") and c.Text or ""
 caseData[#caseData + 1] = {
 name = c.Name,
 price = parsePrice(text),
 vip = text:find(" ", 1, true) ~= nil, }
 end
 end
 table.sort(caseData, function(a, b)
 if a.price ~= b.price then
 return a.price < b.price
 end
 return a.name < b.name
 end)
 return #caseData
end
