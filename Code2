local function guiCenter(btn)
 local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
 local y = pos.Y
 local gui = btn:FindFirstAncestorOfClass("ScreenGui")
 if gui and not gui.IgnoreGuiInset then
 y += GuiService:GetGuiInset().Y
 end
 return math.floor(pos.X + 0.5), math.floor(y + 0.5)
end
local function onScreen(btn)
