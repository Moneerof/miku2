local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
 data = data:gsub("[^%w%+/=]", "")
 local native = (crypt and crypt.base64decode)
 or (crypt and crypt.base64 and crypt.base64.decode)
 or base64_decode
 or (base64 and base64.decode)
 if native then
 local ok, res = pcall(native, data)
 if ok and res and #res > 0 then
 return res
 end
 end
 local map = {}
 for i = 1, 64 do
 map[B64_CHARS:byte(i)] = i - 1
 end
 local out = {}
 for i = 1, #data, 4 do
 local a, b, c, d = data:byte(i, i + 3)
 a, b, c, d = map[a], map[b], map[c], map[d]
 if not (a and b) then
 break
 end
 local n = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)
 local b1 = math.floor(n / 65536) % 256
 local b2 = math.floor(n / 256) % 256
 local b3 = n % 256
 if c and d then
 out[#out + 1] = string.char(b1, b2, b3)
 elseif c then
 out[#out + 1] = string.char(b1, b2)
 else
 out[#out + 1] = string.char(b1)
 end
 end
 return table.concat(out)
end
local function loadEmbeddedMiku()
 if not (writefile and getcustomasset) then
 return nil end
 local ok, asset = pcall(function()
 writefile("SolanaHub_miku.jpg", b64decode(MIKU_B64))
 return getcustomasset("SolanaHub_miku.jpg")
 end)
 if ok and asset then
 return asset
 end
 return nil
end
