--[[
 Solana Hub v4 | Zenthra-style UI
 Presses the game's REAL buttons only (found with the Script Scanner) —
 Cases list, the exact "Sell" button, popup OK. No screen tapping at all.
 v4: removed all screen-tap / coordinate logic and the Positions tab.
 Auto Buy and Auto Sell now run only through real button clicks.
 Tabs
 Auto Farm - toggle, case, delays, sell limits, live session stats
 Cases - browse / search every case by price, tap one to farm it
 Misc - anti-AFK, save config, unload
 Gui - background image, visibility, UI size, accent color
 Extras: settings auto-save, toast notifications, pop animations,
 RightShift hides/shows the window (PC).
 Miku art is embedded at the bottom of this file.
]]
---------------------------------------------------------
-- CONFIG
---------------------------------------------------------
local CONFIG_FILE = "SolanaHub_config.json"
-- Only used if your executor can't do writefile / getcustomasset:
local MIKU_FALLBACK_ID = "" -- e.g. "rbxassetid://123456789"
---------------------------------------------------------
-- SERVICES
---------------------------------------------------------
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
---------------------------------------------------------
-- SAVED SETTINGS
---------------------------------------------------------local presets = {
 { name = "Cyan", color = Color3.fromRGB(0, 225, 205) },
 { name = "Purple", color = Color3.fromRGB(170, 80, 255) },
 { name = "Pink", color = Color3.fromRGB(255, 105, 180) },
 { name = "Red", color = Color3.fromRGB(255, 75, 90) },
 { name = "Gold", color = Color3.fromRGB(255, 200, 50) },
}
local cfg = {
 openDelay = 0.5,
 sellDelay = 2.5,
 accentIndex = 1,
 visibility = 0.5,
 uiScale = 1,
 antiAfk = false,
 imageSource = "",
 caseName = "VIP Free Case",
 maxSells = 4,
 dismissPopups = true,
 gotoCases = true,
}
local function loadConfig()
 if not (isfile and readfile) then
 return
 end
 local ok, data = pcall(function()
 if not isfile(CONFIG_FILE) then
 return nil
 end
 return HttpService:JSONDecode(readfile(CONFIG_FILE))
 end)
 if not ok or type(data) ~= "table" then
 return
 end
 if type(data.openDelay) == "number" then
 cfg.openDelay = math.max(data.openDelay, 0.05)
 end
 if type(data.sellDelay) == "number" then
 cfg.sellDelay = math.max(data.sellDelay, 0.05)
 end
 if type(data.visibility) == "number" then
 cfg.visibility = math.clamp(data.visibility, 0, 1)
 end
 if type(data.uiScale) == "number" then
 cfg.uiScale = math.clamp(data.uiScale, 0.6, 1.2) end
 if type(data.accentIndex) == "number" and presets[data.accentIndex] then
 cfg.accentIndex = data.accentIndex
 end
 if type(data.antiAfk) == "boolean" then
 cfg.antiAfk = data.antiAfk
 end
 if type(data.imageSource) == "string" then
 cfg.imageSource = data.imageSource
 end
 if type(data.caseName) == "string" and data.caseName ~= "" then
 cfg.caseName = data.caseName
 end
 if type(data.maxSells) == "number" then
 cfg.maxSells = math.clamp(math.floor(data.maxSells), 1, 20)
 end
 if type(data.dismissPopups) == "boolean" then
 cfg.dismissPopups = data.dismissPopups
 end
 if type(data.gotoCases) == "boolean" then
 cfg.gotoCases = data.gotoCases
 end
end
loadConfig()
local saveQueued = false
local function saveConfig()
 if not writefile or saveQueued then
 return
 end
 saveQueued = true
 task.delay(0.5, function()
 saveQueued = false
 pcall(function()
 writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
 end)
 end)
end
