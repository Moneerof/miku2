local function pressButton(btn)
 if not getconnections then
 if firesignal then
 return (pcall(firesignal, btn.MouseButton1Click))
 end
 return false
 end
 local function fire(ev)
 local ok, conns = pcall(getconnections, ev)
 if not (ok and conns and #conns > 0) then
 return false
 end
 if firesignal then
 return (pcall(firesignal, ev))
 end
 local any = false
 for _, c in ipairs(conns) do
 if pcall(function()
 c:Fire()
 end) then
 any = true
 end
 end
 return any
 end
 local fired = fire(btn.Activated)
 fired = fire(btn.MouseButton1Click) or fired
 if not fired then
 fired = fire(btn.MouseButton1Down)
 end
 return fired
end
-- press it using the game's own click handlers (no screen taps)
