end
local function collectSell(root, out)
 for _, child in ipairs(root:GetChildren()) do
 local n = child.Name
 if n ~= "CasesList" and n ~= "UI_FrameWork" and n ~= "InventoryTemplate" then
 if child:IsA("GuiButton") then
