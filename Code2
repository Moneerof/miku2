local httpRequest = request or http_request or (syn and syn.request)
-- hosts that are always a direct image file, even with no file extension in the URL
local DIRECT_IMAGE_HOSTS = {
 "i%.pinimg%.com", "i%.imgur%.com", "pbs%.twimg%.com",
 "media%.discordapp%.net", "cdn%.discordapp%.com", "images%.unsplash%.com",
}
local function isDirectImageUrl(url)
 local lower = url:lower()
 if lower:match("%.jpe?g%f[%A]") or lower:match("%.png%f[%A]")
 or lower:match("%.gif%f[%A]") or lower:match("%.webp%f[%A]") then
 return true
 end
 for _, pat in ipairs(DIRECT_IMAGE_HOSTS) do
 if lower:match(pat) then
 return true
 end
 end
 return false
end
-- pulls the actual photo URL out of a webpage (Pinterest, Imgur, Twitter/X,
-- and most other sites that tag their preview image the standard way)
local function extractImageFromHtml(html)
 local url = html:match('"orig":%s*{%s*"url":%s*"([^"]+)"')
 or html:match('property=[\'"]og:image[\'"]%s+content=[\'"]([^\'"]+)[\'"]')
 or html:match('content=[\'"]([^\'"]+)[\'"]%s+property=[\'"]og:image[\'"]')
 or html:match('name=[\'"]twitter:image[\'"]%s+content=[\'"]([^\'"]+)[\'"]')
 or html:match('"image_medium_url":"([^"]+)"')
 if not url then
 return nil
 end
 url = url:gsub("\\/", "/"):gsub("&amp;", "&") return url
end
local function fetchBody(url)
 if not httpRequest then
 return nil
 end
 local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
 if ok and res and res.Body and #res.Body > 0 then
 return res.Body
 end
 return nil
end
-- resolves any webpage link (a Pinterest pin, an Imgur post, etc.) to the
-- direct image URL it actually points at
local function resolvePageImage(url)
 local html = fetchBody(url)
 if not html then
 return nil
 end
 return extractImageFromHtml(html)
end
local function loadFromUrl(url)
 if not (writefile and getcustomasset) then
 return nil
 end
 local body = fetchBody(url)
 if not body then
 return nil
 end
 local ext = url:lower():match("%.jpe?g") and "jpg" or "png"
 local file = "SolanaHub_bg." .. ext
 local okWrite = pcall(writefile, file, body)
 if okWrite then
 local okAsset, asset = pcall(getcustomasset, file)
 if okAsset then
 return asset
 end
 end
 return nil
end
local function applyImage(text)
 text = text:gsub("^%s+", ""):gsub("%s+$", "") if text == "" then
 BgImage.Image = defaultBackground
 return true, "cleared"
 end
 if text:match("^https?://") then
 local imageUrl = text
 if not isDirectImageUrl(text) then
 local resolved = resolvePageImage(text)
 if not resolved then
 return false, "page"
 end
 imageUrl = resolved
 end
 local asset = loadFromUrl(imageUrl)
 if asset then
 BgImage.Image = asset
 return true
 end
 return false, "fetch"
 end
 local id = text:match("%d+")
 if id then
 BgImage.Image = "rbxassetid://" .. id
 return true
 end
 return false, "format"
end
