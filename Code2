-- TAB 2: AUTO CASE (Dropdown + Toggle Configuration)
-- ==========================================
local CaseTab = Window:CreateTab("Auto Case", 4483362458)

CaseTab:CreateSection("Case Opener Settings")

-- Variables to keep track of state
local SelectedCase = "Free Case" -- Default value
local AutoCaseEnabled = false

-- Dropdown to choose a case (Only one can be chosen at a time)
CaseTab:CreateDropdown({
   Name = "Select Target Case",
   Options = {"Free Case", "Vip Free case", "1% Overseer", "Gilded"},
   CurrentOption = {"Free Case"},
   MultipleOptions = false,
   Callback = function(Option)
       SelectedCase = Option[1]
   end,
})

-- Toggle switch to handle the execution loop
CaseTab:CreateToggle({
   Name = "Enable Auto Open",
   CurrentValue = false,
   Callback = function(Value)
       AutoCaseEnabled = Value
       
       -- Creates an independent background loop so your game doesn't crash/freeze
       task.spawn(function()
           while AutoCaseEnabled do
               if SelectedCase == "Free Case" then
                   -- "Paste RemoteFunction for Free Case"
               elseif SelectedCase == "Vip Free case" then
                   -- "Paste RemoteFunction for Vip Free case"
               elseif SelectedCase == "1% Overseer" then
                   -- "Paste RemoteFunction for 1% Overseer"
               elseif SelectedCase == "Gilded" then
                   -- "Paste RemoteFunction for Gilded"
               end
               task.wait(1) -- Adjust this delay (in seconds) to match case opening animation speeds
           end
       end)
   end,
})


